# Copy to backend/.env and fill in. backend/.env is gitignored.
# NEVER put a real key in this file — it is committed to the repo.

# Secret used to sign session cookies. Change for anything non-local.
LINEIS_SECRET_KEY=change-me-to-a-long-random-string

# Groq API key enables the AI lineage review agent (Review tab).
GROQ_API_KEY=
# Optional overrides:
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
