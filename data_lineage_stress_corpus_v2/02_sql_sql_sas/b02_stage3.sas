proc sort data=raw.fx_rates_b02 out=workx.fx_sorted; by currency_code rate_date descending loaded_at descending source_priority; run;
data workx.fx_latest; set workx.fx_sorted; by currency_code rate_date; if first.rate_date; run;
proc sql;
  create table mart.customer_risk_daily_b02 as
  select s.event_ts format=yymmdd10. as business_date, s.customer_id, s.account_id, s.risk_tier,
         count(distinct s.transaction_id) as txn_count,
         sum(s.net_amount*coalesce(f.rate_to_usd,1)) as amount_usd,
         sum(case when s.txn_class='LARGE' then 1 else 0 end) as large_count
  from workx.stage3_rules s left join workx.fx_latest f
    on s.currency_code=f.currency_code and datepart(s.event_ts)=f.rate_date
  group by calculated business_date, s.customer_id, s.account_id, s.risk_tier;
quit;
proc append base=mart.audit_b02 data=workx.stage3_union force; run;
%macro emit_snapshot(suffix=);
  data mart.snapshot_b02_&suffix.; set mart.customer_risk_daily_b02; run;
%mend;
%emit_snapshot(suffix=stage3);
data workx.self_join_probe_3; merge workx.stage3_rules(in=a) workx.stage3_rules(in=b); by transaction_id; if a and b; run;
proc sql; create table workx.union_probe_3 as select transaction_id from workx.stage3_rules union select transaction_id from raw.chargebacks_b02; quit;
%let dynamic_suffix=stage3;
data workx.dynamic_&dynamic_suffix.; set workx.stage3_rules; run;
