/* Stress fixture b02 stage 3; SAS Base-style pipeline. */
%let run_mode=production;
%let batch_prefix=b02;
libname raw '/warehouse/b02/raw';
libname ref '/warehouse/b02/reference';
libname workx '/warehouse/b02/work';
libname mart '/warehouse/b02/mart';
filename rules '/config/b02/risk_rules.csv';
proc import datafile=rules out=workx.rules_import dbms=csv replace; guessingrows=max; getnames=yes; run;
data workx.stage3_base;
  length customer_key $64 channel_norm $32;
  set raw.transactions_b02(where=(status in ('POSTED','SETTLED') or not missing(reversal_of)));
  if missing(event_ts) then delete;
  customer_key = cats('C', put(customer_id, z12.));
  net_amount = sum(amount, 0) - sum(fee, 0);
  channel_norm = lowcase(compbl(strip(channel)));
  if _n_ = 1 then do;
    declare hash cust(dataset:'raw.customer_history_b02(where=(is_deleted=0))');
    cust.defineKey('customer_id');
    cust.defineData('segment','country_code','updated_at');
    cust.defineDone();
  end;
  rc = cust.find(key:customer_id);
  drop rc;
run;
proc sort data=workx.stage3_base; by customer_id descending updated_at; run;
data workx.stage3_dedup;
  set workx.stage3_base;
  by customer_id descending updated_at;
  if first.customer_id;
run;
proc sql;
  create table workx.stage3_rules as
  select b.*, coalescec(r.risk_tier,'UNKNOWN') as risk_tier length=16,
         case when not missing(b.reversal_of) then 'REVERSAL'
              when abs(b.net_amount) >= coalesce(r.large_txn_threshold,10000) then 'LARGE'
              when b.net_amount < 0 then 'NEGATIVE' else 'NORMAL' end as txn_class length=12,
         (r.rule_id is null) as rule_missing
  from workx.stage3_dedup b left join ref.risk_rules_b02 r
    on b.country_code = r.country_code
   and b.event_ts >= r.valid_from
   and (b.event_ts < r.valid_to or missing(r.valid_to))
   and (missing(r.segment) or r.segment=b.segment);
quit;
data workx.stage3_metric001;
  set workx.stage3_rules;
  if txn_class='REVERSAL' then metric_001=-abs(net_amount)*1/100;
  else if txn_class='LARGE' then metric_001=coalesce(net_amount,0)*1/100;
  else if rule_missing then metric_001=coalesce(net_amount,0)*1/1000;
  else metric_001=coalesce(net_amount,0)*1/10000;
run;
